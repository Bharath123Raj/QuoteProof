# Paste your key here for the loopback local server. Never commit a filled .env.
SERPAPI_API_KEY=
SHARED_MONTHLY_LIMIT=200
SHARED_USER_DAILY_LIMIT=30
SHARED_USER_MINUTE_LIMIT=12
PORT=3000
# Hosted Sites only: configure this and the key in production runtime settings.
# AUTH_PROVIDER=sites
# Cloudflare: .env is local only. Use Wrangler secret put SERPAPI_API_KEY.
# wrangler.json already sets AUTH_PROVIDER=cloudflare-access for that deployment.
